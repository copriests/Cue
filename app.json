{
  "expo": {
    "name": "Cue",
    "slug": "cue-teleprompter",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.copriests.cue",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Cue listens to your voice to follow your script while you rehearse.",
        "NSSpeechRecognitionUsageDescription": "Cue matches on-device speech to your script so it can follow your pace.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "platforms": [
      "ios"
    ],
    "extra": {
      "eas": {
        "projectId": "71b165e4-6408-4b8b-afa2-c0eeaf397ed8"
      }
    }
  }
}
